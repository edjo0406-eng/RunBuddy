{
  "expo": {
    "name": "RunBuddy",
    "slug": "runbuddy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "runbuddy-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.runbuddy.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "com.runbuddy.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F1",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
